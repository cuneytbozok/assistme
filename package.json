{
  "name": "sn-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only ServiceNow MCP connector: local MCP server + Chrome session bridge",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/extension"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "lint": "biome check .",
    "format": "biome check --write .",
    "e2e:live": "npm run build && node test/e2e/live.ts",
    "pack:mcpb": "npm run build -w @sn-mcp/shared && npm run pack:mcpb -w @sn-mcp/server",
    "install-native-host": "npm run install-native-host -w @sn-mcp/server --"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
