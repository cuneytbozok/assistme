{
  "manifest_version": 3,
  "name": "sn-mcp Session Bridge",
  "version": "0.0.1",
  "key": "",
  "description": "Read-only bridge between a local ServiceNow MCP server and your ServiceNow session. You approve every instance.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "nativeMessaging", "notifications"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "sn-mcp Session Bridge",
    "default_popup": "popup.html"
  }
}
