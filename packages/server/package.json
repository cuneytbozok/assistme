{
  "name": "@sn-mcp/server",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "description": "Local MCP server (stdio) and Chrome native-messaging broker",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && vitest run",
    "install-native-host": "node dist/bin/install-native-host.js",
    "dev-client": "node dist/bin/dev-client.js",
    "start": "node dist/bin/mcp-server.js",
    "check-capture": "node dist/bin/check-capture.js",
    "pack:mcpb": "node build.mjs && mcpb validate mcpb-build/manifest.json && mcpb pack mcpb-build sn-mcp.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@sn-mcp/shared": "0.0.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "sn-mcp-native-host": "dist/bin/native-host.js",
    "sn-mcp-server": "dist/bin/mcp-server.js"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@modelcontextprotocol/client": "^2.4.0",
    "esbuild": "^0.28.2"
  }
}
